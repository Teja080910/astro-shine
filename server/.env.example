# Server Environment Variables

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/astro_shine
JWT_SECRET=your-super-secret-jwt-key-change-in-production
PORT=3000

# Agora.io (Voice/Video Calls)
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# MSG91 (SMS/OTP)
MSG91_API_KEY=your-msg91-api-key
MSG91_OTP_TEMPLATE_ID=your-otp-template-id
MSG91_SENDER_ID=MSGIND

# Razorpay (Payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# RazorpayX (Payouts)
RAZORPAYX_KEY_ID=rzp_live_xxxxxxxx
RAZORPAYX_KEY_SECRET=xxxxxxxx
RAZORPAYX_DEFAULT_ACCOUNT=2323230000001234
