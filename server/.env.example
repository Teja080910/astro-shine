# Server Environment Variables

# Core
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/astro_shine
PORT=3000
CORS_ORIGIN=*

# Auth (JWT)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Admin Seeding (seed-admin.ts)
ADMIN_EMAIL=admin@astroshine.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Super Admin

# MSG91 (SMS/OTP)
MSG91_API_KEY=your-msg91-api-key
MSG91_OTP_TEMPLATE_ID=your-otp-template-id
MSG91_SENDER_ID=MSGIND
MSG91_WIDGET_ID=your-msg91-widget-id
MSG91_TOKEN_AUTH=your-msg91-token-auth

# Resend (Email)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@astroshine.com
RESEND_FROM_NAME=Astro Shine

# Razorpay (Payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# RazorpayX (Payouts)
RAZORPAYX_KEY_ID=rzp_live_xxxxxxxx
RAZORPAYX_KEY_SECRET=xxxxxxxx
RAZORPAYX_DEFAULT_ACCOUNT=2323230000001234
RAZORPAYX_WEBHOOK_SECRET=xxxxxxxx

# LiveKit (Video Calls)
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# AstrologyAPI (Kundli, Matchmaking, Panchang, Horoscope, Muhurat)
# https://www.astrologyapi.com — Basic Auth: User ID is username, API Key is password
ASTRO_API_USER_ID=your-astrologyapi-user-id
ASTRO_API_KEY=your-astrologyapi-api-key

# Supabase (Auth/Storage)
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Cloudinary (Media)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# MinIO (Object Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=astro-shine
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000
