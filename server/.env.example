# Server Environment Variables

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/astro_shine
JWT_SECRET=your-super-secret-jwt-key-change-in-production
PORT=3000

# Agora.io (Voice/Video Calls)
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# MSG91 (SMS/OTP)
MSG91_API_KEY=your-msg91-api-key
MSG91_OTP_TEMPLATE_ID=your-otp-template-id
MSG91_SENDER_ID=MSGIND

# Razorpay (Payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# RazorpayX (Payouts)
RAZORPAYX_KEY_ID=rzp_live_xxxxxxxx
RAZORPAYX_KEY_SECRET=xxxxxxxx
RAZORPAYX_DEFAULT_ACCOUNT=2323230000001234

# LiveKit (Video Calls)
LIVEKIT_HOST=your-livekit-host:7880
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# AstrologyAPI (Kundli, Matchmaking, Panchang, Horoscope, Muhurat)
# https://www.astrologyapi.com — Basic Auth: User ID is username, API Key is password
ASTRO_API_USER_ID=your-astrologyapi-user-id
ASTRO_API_KEY=your-astrologyapi-api-key

# Supabase (Auth/Storage)
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Cloudinary (Media)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
