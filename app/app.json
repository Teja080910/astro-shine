{
  "expo": {
    "name": "Astroshine",
    "slug": "astro-shine-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090B",
    "splash": {
      "image": "./assets/logo_clean.png",
      "backgroundColor": "#09090B",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.astroshine.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_clean.png",
        "backgroundColor": "#09090B"
      },
      "package": "com.astroshine.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Astro Shine to use your location to show weather and local panchang data.",
          "locationWhenInUsePermission": "Allow Astro Shine to use your location to show weather and local panchang data."
        }
      ],
      "expo-audio",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "2718ae98-737a-4e1f-a144-bc7caaf39d26"
      }
    }
  }
}
